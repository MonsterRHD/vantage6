diff --git a/vantage6-hq/tests_hq/resources/test_run.py b/vantage6-hq/tests_hq/resources/test_run.py
index 2af9b38f2..801ba22eb 100644
--- a/vantage6-hq/tests_hq/resources/test_run.py
+++ b/vantage6-hq/tests_hq/resources/test_run.py
@@ -138,3 +138,65 @@ class TestResources(TestResourceBase):
             col.delete()
             org1.delete()
             org2.delete()
+
+    def test_run_log_query_returns_empty_string_when_no_log(self):
+        org = Organization()
+        col = Collaboration(organizations=[org])
+        task = Task(collaboration=col, image="some-image", init_org=org)
+        task.save()
+        run = Run(
+            task=task,
+            organization=org,
+            status=RunStatus.PENDING.value,
+            action=AlgorithmStepType.CENTRAL_COMPUTE.value,
+        )
+        run.save()
+        try:
+            headers = self.login_as_root()
+            response = self.app.get(f"/api/run/{run.id}", headers=headers)
+            self.assertEqual(response.status_code, HTTPStatus.OK)
+            self.assertEqual(response.json["log"], "")
+            # the acknowledgement cursor is exposed so nodes can resume a log
+            # stream after a restart
+            self.assertEqual(response.json["log_seq"], 0)
+        finally:
+            run.delete()
+            task.delete()
+            col.delete()
+            org.delete()
+
+    def test_run_patch_empty_log_is_kept_and_status_patch_preserves_it(self):
+        org = Organization(name=str(uuid.uuid1()))
+        col = Collaboration(name=str(uuid.uuid1()), organizations=[org])
+        col.save()
+        node = self.create_node(organization=org, collaboration=col)
+        task = Task(
+            image="localhost/algorithms/test:local",
+            collaboration=col,
+            init_org=org,
+        )
+        task.save()
+        run = Run(task=task, organization=org, status=RunStatus.PENDING.value)
+        run.save()
+        try:
+            headers = self.login_node(node)
+            response = self.app.patch(
+                f"/api/run/{run.id}", headers=headers, json={"log": ""}
+            )
+            self.assertEqual(response.status_code, HTTPStatus.OK)
+            self.assertEqual(response.json["log"], "")
+
+            # a status-only PATCH must not erase the (empty) log
+            response = self.app.patch(
+                f"/api/run/{run.id}",
+                headers=headers,
+                json={"status": RunStatus.PENDING.value},
+            )
+            self.assertEqual(response.status_code, HTTPStatus.OK)
+            self.assertEqual(response.json["log"], "")
+        finally:
+            run.delete()
+            task.delete()
+            node.delete()
+            col.delete()
+            org.delete()
diff --git a/vantage6-hq/tests_hq/resources/test_websocket_algorithm_log.py b/vantage6-hq/tests_hq/resources/test_websocket_algorithm_log.py
new file mode 100644
index 000000000..bc057af78
--- /dev/null
+++ b/vantage6-hq/tests_hq/resources/test_websocket_algorithm_log.py
@@ -0,0 +1,152 @@
+"""
+Tests for the algorithm log websocket handler.
+
+The handler is cursor-aware: newer nodes send a per-run line sequence number
+(``seq``) and HQ acknowledges how many lines it persisted, so that duplicates
+are ignored, gaps trigger a resend request, late lines after completion are
+discarded, and events from older nodes (without ``seq``) keep working.
+"""
+
+import datetime
+from unittest import TestCase
+from unittest.mock import Mock, patch
+
+from vantage6.common.enum import AlgorithmStepType, RunStatus
+
+from vantage6.hq.model import Collaboration, Organization, Run, Task
+from vantage6.hq.model.base import Database
+from vantage6.hq.websockets import DefaultSocketNamespace
+
+
+class TestAlgorithmLogHandler(TestCase):
+    @classmethod
+    def setUpClass(cls):
+        Database().connect("sqlite://", allow_drop_all=True)
+
+    @classmethod
+    def tearDownClass(cls):
+        Database().clear_data()
+        Database().close()
+
+    def setUp(self):
+        org = Organization()
+        col = Collaboration(organizations=[org])
+        task = Task(collaboration=col, image="some-image", init_org=org)
+        task.save()
+        self.run = Run(
+            task=task,
+            organization=org,
+            status=RunStatus.ACTIVE.value,
+            action=AlgorithmStepType.CENTRAL_COMPUTE.value,
+            log=None,
+            log_seq=0,
+        )
+        self.run.save()
+        self.namespace = DefaultSocketNamespace(
